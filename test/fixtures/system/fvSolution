/*--------------------------------*- C++ -*----------------------------------*\
| dictator test fixture: fvSolution with a PIMPLE block, for the sub-        |
| dictionary "-help" table (dictator system/fvSolution PIMPLE -help).       |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p_rgh
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-07;
        relTol          0.05;
    }
}

PIMPLE
{
    nOuterCorrectors            3;
    nCorrectors                 2;
    nNonOrthogonalCorrectors    1;
    momentumPredictor           no;
    turbulentPotato             yes;   // not a real key - should be flagged

    residualControl
    {
        p_rgh
        {
            tolerance   1e-4;
            relTol      0;
        }
    }
}

relaxationFactors
{
    equations
    {
        ".*"    1;
    }
}
