#!/bin/bash

# dictator uses bash arrays and programmable completion, which other shells
# provide differently, so refuse to be sourced by anything else rather than
# silently misbehave.
if [ -z "${BASH_VERSION:-}" ]; then
    echo "dictator: requires bash (source it from bash)" >&2
    return 1 2>/dev/null || exit 1
fi

_DICTATOR_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# dictator - inspect, set and explain OpenFOAM dictionary parameters, with tab
# completion at every position. Source this file from bash; "dictator -help"
# prints a summary.
#
#   dictator          inspect, set and explain dictionary parameters
#   setDictEntry      set the value of one dictionary entry
#   getDictEntry      print the value of one dictionary entry
#   listDictEntries   print every entry path in a dictionary file
#
# The parameter documentation printed by "dictator <file> <parameter> -help"
# lives in dictatorHelp beside this script, generated by makeDictatorHelp from
# an OpenFOAM source tree.
#
